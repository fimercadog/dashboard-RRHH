# URL base de la API Laravel, incluyendo el prefijo /api.
# Sin esta variable, el frontend usa la ruta relativa "/api" y depende del
# rewrite en next.config.ts (solo funciona si frontend y backend corren en
# la misma maquina, como en desarrollo local).
#
# En despliegues donde el backend vive en otro dominio/servidor (Hostinger,
# Railway, un tunel de ngrok, etc.) hay que definir esta variable con la URL
# publica real del backend. Debe empezar en https:// en produccion.
#
# Ejemplo local:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8001/api
#
# Ejemplo produccion:
# NEXT_PUBLIC_API_URL=https://api.tu-dominio.com/api
NEXT_PUBLIC_API_URL=
