# =============================================================================
# k6 Load Test Environment Variables
# =============================================================================
# Copy this file to .env (tests/performance/.env) and fill in the values.
# NEVER commit the real .env file — it is already in .gitignore.
#
# SEGURIDAD — reglas invariantes:
#
#   1. El company_id viene del token Sanctum, NO como parámetro en el payload.
#      BaseCrudController lo extrae del usuario autenticado y lo impone en
#      toda escritura. No lo incluyas en los bodies k6 — sería ignorado de
#      todos modos (CompanyIsolationStoreTest lo verifica).
#
#   2. Solo ejecutar escrituras (POST/PATCH/DELETE) contra datos de prueba
#      aislados en un ambiente local o de staging. Nunca contra producción.
#
#   3. Nunca hardcodear passwords en los scripts k6. Leerlos siempre desde
#      __ENV.K6_PASS (y el resto de variables abajo).
#
#   4. Nunca usar credenciales de usuarios reales de producción en estos tests.
#      El seeder provee usuarios de demo con password conocido — úsalos en local.
#
#   5. El aislamiento multiempresa es por token: cada petición autenticada solo
#      puede ver y modificar datos de la empresa del usuario del token.
#      Un usuario de empresa A nunca ve registros de empresa B, aunque los
#      busque por ID en la URL (IDOR imposible con BaseCrudController).
# =============================================================================

# URL base del backend Laravel en el ambiente de pruebas.
# En local: http://127.0.0.1:8001 (php artisan serve)
# En staging: https://api-staging.tudominio.com
BASE_URL=http://127.0.0.1:8001

# -----------------------------------------------------------------------------
# Credenciales para los tests de carga
# -----------------------------------------------------------------------------
# Usuario recomendado para tests de LECTURA y escrituras sobre datos demo:
#   admin@andespeople.co  (rol: Administrador de empresa)
#   Tiene acceso a: employees, attendance, requests, documents, reports,
#                   leads, inventory, CRM, ventas, compras, contabilidad.
#   NO tiene: whatsapp.manage, ai.manage, integrations.view
#             (esos son solo del Super Admin — no necesarios para load tests).
#
# Alternativa para cubrir TODOS los módulos (incluyendo integraciones):
#   superusuario@andespeople.co  (rol: Super Admin)
#
# NOTA: El seeder crea todos los usuarios con password "password".
#       En staging usa un password distinto generado con php artisan tinker.
K6_USER=admin@andespeople.co
K6_PASS=

# -----------------------------------------------------------------------------
# company_id del usuario de pruebas
# -----------------------------------------------------------------------------
# El ID se resuelve automáticamente desde el token después del login —
# NO hace falta pasarlo en los payloads (sería ignorado por BaseCrudController).
# Se incluye aquí solo para scripts que necesiten construir URLs con IDs
# (ej. /api/companies/{id}/dashboard) sin hacer un GET extra.
#
# Cómo obtenerlo: POST /api/login → campo "user.company_id" en la respuesta.
# En el seeder por defecto la empresa es "Andes People Solutions".
K6_COMPANY_ID=

# -----------------------------------------------------------------------------
# Configuración de carga (opcional — los scripts tienen defaults razonables)
# -----------------------------------------------------------------------------
# Número de usuarios virtuales concurrentes
K6_VUS=10

# Duración total de cada escenario
K6_DURATION=30s

# Límite de tasa de error aceptable (0.01 = 1%)
K6_MAX_ERROR_RATE=0.01

# Latencia p95 máxima aceptable en milisegundos
K6_MAX_P95_MS=500
